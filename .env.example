APP_NAME=Hito
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO

# Set to true when the application is served over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=8

# Temporary account lockout after consecutive failed logins.
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Set to true only when the API is behind a trusted reverse proxy.
TRUST_PROXY_HEADERS=false

# Local storage directory when running outside Docker.
UPLOAD_DIR=uploads

POSTGRES_DB=hito
POSTGRES_USER=hito
POSTGRES_PASSWORD=change-me
